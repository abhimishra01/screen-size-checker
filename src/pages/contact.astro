---
import Page from '../layouts/Page.astro';
import site from '../site.config.ts';
---
<Page noindex title="Contact" description="Contact Screen Size Checker. Report a wrong size, suggest a feature or ask how the free card measuring tool works. We try to reply within a few days.">
  <p>We want to hear about bugs, ideas and anything that is unclear.</p>
  <p>{site.contactWord}: <a href={site.contactHref}>{site.contactLabel}</a></p>
  <p>We try to reply within a few days. Please include the browser and device you use if you report a problem.</p>
</Page>
